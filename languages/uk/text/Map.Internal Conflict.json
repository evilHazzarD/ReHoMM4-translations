[
 {
  "id": 0,
  "where": "map name",
  "text": "Внутрішній розбрат",
  "key": "d28cbe1cc8db"
 },
 {
  "id": 1,
  "where": "map description",
  "text": "Навіть облога не змушує мешканців цього міста перестати битися між собою. Але чи вдасться владнати чвари до того, як мури впадуть під натиском облоги?",
  "key": "3fc28c7f0110"
 },
 {
  "id": 2,
  "where": "map",
  "text": "Протягом 4 місяців залишіться єдиним гравцем у міських мурах.",
  "key": "10cb004969ac"
 },
 {
  "id": 3,
  "where": "map",
  "text": "Ви маєте перемогти всіх ворогів у місті, і поспішайте, бо ваша магія втримає мури лише ще чотири місяці. Але ваш ключ до сусідніх кварталів, одну з чотирьох чарівних палиць, щойно викрали, тож насамперед треба його знайти.",
  "key": "09ae00d724b1"
 },
 {
  "id": 4,
  "where": "map",
  "text": "Під час наради про зниклий ключ усі радники погоджуються, що він досі десь у вашій частині міста. Зовнішні мури не проломлено, і крізь брами останнім часом ніхто не проходив. Вони кажуть, що ключ може бути схований будь-де, його навіть можуть носити створіння, яких нещодавно розворушив вулкан.",
  "key": "4dadce48ca83"
 },
 {
  "id": 5,
  "where": "map",
  "text": "",
  "key": "560b10cb88b3"
 },
 {
  "id": 6,
  "where": "map",
  "text": "Сталося виверження вулкана",
  "key": "5bb1cf6aef2a"
 },
 {
  "id": 7,
  "where": "map",
  "text": "Мури проломлено. Тепер вам непереливки...",
  "key": "7ea28622b583"
 },
