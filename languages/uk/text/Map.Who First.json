[
 {
  "id": 0,
  "where": "map name",
  "text": "Хто перший?",
  "key": "d318b8b784da"
 },
 {
  "id": 1,
  "where": "map description",
  "text": "Десь є ключ до доброго життя, але як його знайти? ",
  "key": "47bc98cbba83"
 },
 {
  "id": 2,
  "where": "map",
  "text": "Втратити всі міста й війська.",
  "key": "f44ef8dbe1ea"
 },
 {
  "id": 3,
  "where": "map",
  "text": "Візьміть Скриньку Пандори.",
  "key": "8cfb72be4851"
 },
 {
  "id": 4,
  "where": "map",
  "text": "Хто перший v1.3.\nЗроблено у вересні 2002 року, автор kukas. kestasmik@yahoo.com\nЗмінено в жовтні.",
  "key": "aed20e46f75f"
 },
 {
  "id": 5,
  "where": "map",
  "text": "",
  "key": "08d331afd385"
 },
 {
  "id": 6,
  "where": "map",
  "text": "Я чув про чорних драконів. Вони зараз активні. Гадаю, вам варто тримати кількох чорних драконів у своїх містах.",
  "key": "40d4453a44c5"
 },
 {
  "id": 7,
  "where": "map",
  "text": "",
  "key": "32aae1dd61d0"
 },
 {
  "id": 8,
  "where": "map",
  "text": "Драконячий податок.",
  "key": "c1d8ae531ad0"
 },
 {
  "id": 9,
  "where": "map",
  "text": "",
  "key": "a0225394cbcf"
 },
 {
  "id": 10,
  "where": "map",
  "text": "Ви знаходите трохи золота!",
  "key": "cd731878a83f"
 },
 {
  "id": 11,
  "where": "map",
  "text": "Ви загубили трохи золота! Наступного разу будьте обережніші! ",
  "key": "140056b3386c"
 },
 {
  "id": 12,
  "where": "map",
  "text": "",
  "key": "6ddce6506278"
 },
 {
  "id": 13,
  "where": "map",
  "text": "Ви будите драконів, і вони на вас нападають!",
  "key": "8e7127cc8190"
 },
 {
  "id": 14,
  "where": "map",
  "text": "",
  "key": "52c500e27393"
 },
 {
  "id": 15,
  "where": "map",
  "text": "У вашій армії забагато героїв, за дороги доведеться платити більше!",
  "key": "77f6a3d6be05"
 },
 {
  "id": 16,
  "where": "map",
  "text": "",
  "key": "81fc360f0762"
 },
 {
  "id": 17,
  "where": "map",
  "text": "Сьогодні ваш день!",
  "key": "5b1bb81d2c77"
 },
 {
  "id": 18,
  "where": "map",
  "text": "Бачимо, ти багатий і сильний, тож дай нам 20 000 золота й іди собі з миром, гаразд?",
  "key": "6af3f6cad087"
 },
 {
  "id": 19,
  "where": "map",
  "text": "Отже, хочеш битися. Подивимося, хто сильніший!",
  "key": "927615fb9240"
 },
 {
  "id": 20,
  "where": "map",
  "text": "Пам'ятаєш нашу пропозицію? Добра тобі наука!",
  "key": "8aff82063fd7"
 },
 {
  "id": 21,
  "where": "map",
  "text": "",
  "key": "2d0091fb5ed3"
 },
 {
  "id": 22,
  "where": "map",
  "text": "Ось вам трохи допомоги!",
  "key": "460ac5adec2b"
 },
 {
  "id": 23,
  "where": "map",
  "text": "До вас приєднуються чорні дракони.",
  "key": "c393a0c65d73"
 },
 {
  "id": 24,
  "where": "map",
  "text": "На ваше місто напали!",
  "key": "438672809038"
 },
 {
  "id": 25,
  "where": "map",
  "text": "До вас приєднуються чорні дракони!",
  "key": "fc655a82a948"
 },
