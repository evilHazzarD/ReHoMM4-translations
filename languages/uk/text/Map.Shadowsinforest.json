[
 {
  "id": 0,
  "where": "map name",
  "text": "Тіні в лісах",
  "key": "121204a82278"
 },
 {
  "id": 1,
  "where": "map description",
  "text": "Повернувшись від родичів, Інґа бачить, що рідний ліс кишить загарбниками, а її коханого Яаґупа, на лихо, ув'язнено. Чи зустрінуться вони колись живими?",
  "key": "b7dcb0ff4ff7"
 },
 {
  "id": 2,
  "where": "map",
  "text": "Яаґуп та Інґа мають бути живі й в одній армії",
  "key": "3a0717352b56"
 },
 {
  "id": 3,
  "where": "map",
  "text": "",
  "key": "b60553f50e86"
 },
 {
  "id": 4,
  "where": "map",
  "text": "Ворогів багато, і вони сильні. Інґа не має шансів їх перемогти. Можливо, Яаґуп з ними впорається, але як Інзі визволити його з в'язниці?",
  "key": "643fc8bdcebd"
 },
 {
  "id": 5,
  "where": "map",
  "text": "",
  "key": "32aae1dd61d0"
 },
 {
  "id": 6,
  "where": "map",
  "text": "Здається, надії мало. Можливо, вдасться домовитися з бандитами, що стережуть в'язницю Яаґупа... Поговорімо з ними.",
  "key": "68d3ad2b4e06"
 },
 {
  "id": 7,
  "where": "map",
  "text": "Інґа загинула. Але з Анкхом життя її можна воскресити у святилищі. Колись у цьому лісі було сховано 4 Анкхи, тепер вони, найпевніше, в руках героїв-загарбників. ",
  "key": "330a215758c8"
 },
 {
  "id": 8,
  "where": "map",
  "text": "Тут обоє ваших героїв можуть знову зустрітися.",
  "key": "88a554aa957e"
 },
 {
  "id": 9,
  "where": "map",
  "text": "Приведіть сюди мого татка, він на південному заході.",
  "key": "6e4fe1a637e5"
 },
 {
  "id": 10,
  "where": "map",
  "text": "Шукаю татка",
  "key": "82f7381abdba"
 },
 {
  "id": 11,
  "where": "map",
  "text": "Можна навчити вас ще трохи розвідки?",
  "key": "75ac170f9409"
 },
 {
  "id": 12,
  "where": "map",
  "text": "Іти за вами чи ні? Це питання розриває мою душу на дві ворожі сили...",
  "key": "14c529f196e7"
 },
 {
  "id": 13,
  "where": "map",
  "text": "Ласкаво просимо до нашого села!",
  "key": "7fab88618f1d"
 },
 {
  "id": 14,
  "where": "map",
  "text": "Пройти крізь цю браму можуть лише Яаґуп та Інґа разом, коли знайдуть Анкх життя",
  "key": "e3f954a9fc8c"
 },
 {
  "id": 15,
  "where": "map",
  "text": "Потрібні Інґа, Яаґуп і Анкх життя",
  "key": "4da2b1297ff6"
 },
 {
  "id": 16,
  "where": "map",
  "text": "Пройти можуть лише герої під червоним стягом",
  "key": "6be3ca6409d8"
 },
 {
  "id": 17,
  "where": "map",
  "text": "Потрібно 100 селян на роботу",
  "key": "103e8059314d"
 },
 {
  "id": 18,
  "where": "map",
  "text": "Потрібно 100 селян",
  "key": "badebbbf990a"
 },
 {
  "id": 19,
  "where": "map",
  "text": "Можна взяти їх на роботу?",
  "key": "d52c600d5078"
 },
 {
  "id": 20,
  "where": "map",
  "text": "Хай походження цього чоловіка лишається невідомим.",
  "key": "be54b8cb3639"
 },
 {
  "id": 21,
  "where": "map",
  "text": "",
  "key": "fcac58d7451f"
 },
 {
  "id": 22,
  "where": "map",
  "text": "Хоч вас і переможено, вам вдалося відвернути увагу варти. Ніхто не помітив, як Яаґуп завершив свою довгу роботу чайною ложечкою і частина стіни обвалилася...",
  "key": "504086808f76"
 },
 {
